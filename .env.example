# Copy to .env and adjust if your local Toolshop setup uses different ports.
# .env is gitignored — these defaults match Toolshop's standard Docker Compose setup.

# Frontend (Angular) — used as Playwright's baseURL for page.goto() calls.
BASE_URL=http://localhost:4200

# Backend (Laravel API) — used by the cart-seeding fixture for direct API calls.
API_BASE_URL=http://localhost:8091
